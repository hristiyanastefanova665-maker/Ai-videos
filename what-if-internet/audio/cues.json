[
 {
  "t0": 1.6,
  "t1": 2.95,
  "text": "Утре се събуждаш…"
 },
 {
  "t0": 3.1,
  "t1": 4.95,
  "text": "…и интернетът е изчезнал."
 },
 {
  "t0": 5.05,
  "t1": 6.2,
  "text": "Завинаги."
 },
 {
  "t0": 6.3,
  "t1": 7.85,
  "text": "Първите 10 секунди:"
 },
 {
  "t0": 7.9,
  "t1": 10.85,
  "text": "милиарди хора губят връзка\nс дигиталния свят."
 },
 {
  "t0": 11,
  "t1": 12.15,
  "text": "След един час"
 },
 {
  "t0": 12.2,
  "t1": 13.7,
  "text": "съобщенията спират."
 },
 {
  "t0": 13.76,
  "t1": 15.65,
  "text": "Онлайн плащанията се провалят."
 },
 {
  "t0": 15.72,
  "t1": 17.65,
  "text": "Навигацията вече не работи."
 },
 {
  "t0": 17.8,
  "t1": 19.55,
  "text": "След 24 часа"
 },
 {
  "t0": 19.6,
  "t1": 21.15,
  "text": "бизнеси затварят врати."
 },
 {
  "t0": 21.22,
  "t1": 23.02,
  "text": "Летищата изпитват затруднения,"
 },
 {
  "t0": 23.06,
  "t1": 26.4,
  "text": "а правителствата се опитват\nда разберат какво се случва."
 },
 {
  "t0": 26.52,
  "t1": 27.66,
  "text": "След 7 дни"
 },
 {
  "t0": 27.72,
  "t1": 29.7,
  "text": "хората започват да се адаптират."
 },
 {
  "t0": 29.76,
  "t1": 31.62,
  "text": "Хартиените карти се завръщат."
 },
 {
  "t0": 31.66,
  "t1": 34.05,
  "text": "Радиото отново става жизненоважно,"
 },
 {
  "t0": 34.1,
  "t1": 37.6,
  "text": "а комуникацията лице в лице\nсе превръща в необходимост."
 },
 {
  "t0": 37.72,
  "t1": 39.25,
  "text": "Една година по-късно"
 },
 {
  "t0": 39.3,
  "t1": 40.95,
  "text": "светът вече е различен."
 },
 {
  "t0": 41.02,
  "t1": 42.95,
  "text": "Местните общности се обединяват."
 },
 {
  "t0": 43,
  "t1": 45.4,
  "text": "Старите начини на живот се завръщат."
 },
 {
  "t0": 45.52,
  "t1": 46.78,
  "text": "След 100 години"
 },
 {
  "t0": 46.83,
  "t1": 51,
  "text": "цяло поколение е израснало,\nбез никога да разбере какво е интернет."
 },
 {
  "t0": 51.3,
  "t1": 52.85,
  "text": "След хиляда години"
 },
 {
  "t0": 52.9,
  "t1": 57.6,
  "text": "нашата дигитална цивилизация е останала\nсамо като фрагменти от историята."
 },
 {
  "t0": 57.75,
  "t1": 59.85,
  "text": "А след 10 000 години…"
 },
 {
  "t0": 59.95,
  "t1": 61.62,
  "text": "…може би никой вече няма да помни,"
 },
 {
  "t0": 61.66,
  "t1": 64.8,
  "text": "че някога сме били свързани с целия свят"
 },
 {
  "t0": 64.84,
  "t1": 66.4,
  "text": "само с едно докосване."
 },
 {
  "t0": 66.65,
  "t1": 69.65,
  "text": "Ние създадохме свят, който свърза всички."
 },
 {
  "t0": 69.78,
  "t1": 72.95,
  "text": "Но забравихме ли как да живеем без него?"
 }
]